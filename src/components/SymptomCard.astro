---
/**
 * Tarjeta de síntoma: foto + título + una frase. Sin iconos decorativos:
 * la foto y la jerarquía tipográfica hacen ese trabajo (como en las webs sanitarias de referencia).
 */
import Photo from './Photo.astro';

interface Props {
  title: string;
  text?: string;
  /** Si se pasa, toda la tarjeta es un enlace. */
  href?: string;
  /** Foto opcional (nombre de archivo en src/assets/fotos/). */
  photo?: { name: string; alt: string };
  /** Tarjeta destacada: desde 640 px, foto a la izquierda y texto a la derecha. */
  featured?: boolean;
}

const { title, text, href, photo, featured = false } = Astro.props;
const Wrapper = href ? 'a' : 'article';
---

<Wrapper
  class:list={['symptom', href && 'symptom--link', photo && 'symptom--photo', featured && 'symptom--featured']}
  href={href}
>
  {
    photo && (
      <Photo
        name={photo.name}
        alt={photo.alt}
        decorative={Boolean(href)}
        aiCredit={false}
        sizes={featured ? '(min-width: 640px) 50vw, 88px' : '(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 88px'}
        class="symptom__photo"
      />
    )
  }
  <div class="symptom__body">
    <h3 class="symptom__title">{title}</h3>
    {text && <p class="symptom__text">{text}</p>}
  </div>
</Wrapper>

<style>
  .symptom {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    align-content: start;
    height: 100%;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
  }

  .symptom--link:hover {
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  .symptom--link:hover .symptom__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .symptom__title {
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .symptom__text {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  /* Con foto. Móvil: miniatura cuadrada a la izquierda. */
  .symptom--photo {
    grid-template-columns: 88px 1fr;
    align-items: start;
    padding: var(--space-2);
  }

  .symptom--photo :global(.symptom__photo) {
    aspect-ratio: 1;
    border-radius: 8px;
  }

  /* ≥ 640 px: foto arriba a sangre, texto debajo. */
  @media (min-width: 640px) {
    .symptom--photo {
      grid-template-columns: 1fr;
      padding: 0 var(--space-3) var(--space-4);
    }

    .symptom--photo :global(.symptom__photo) {
      margin-inline: calc(-1 * var(--space-3));
      margin-bottom: var(--space-1);
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
  }

  /* Destacada (≥ 640 px): foto a la izquierda, texto a la derecha. */
  @media (min-width: 640px) {
    .symptom--featured {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-5);
      align-items: center;
      padding: 0;
    }

    .symptom--featured :global(.symptom__photo) {
      margin: 0;
      width: 100%;
      height: 100%;
      min-height: 15rem;
      aspect-ratio: auto;
    }

    .symptom--featured .symptom__body {
      padding: var(--space-5) var(--space-5) var(--space-5) 0;
    }

    .symptom--featured .symptom__title {
      font-size: var(--fs-h1);
      font-weight: 500;
    }

    .symptom--featured .symptom__text {
      font-size: 1.25rem;
    }
  }
</style>
