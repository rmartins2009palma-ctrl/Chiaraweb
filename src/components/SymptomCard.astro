---
import Icon from './Icon.astro';
import Photo from './Photo.astro';

interface Props {
  icon: string;
  title: string;
  text?: string;
  /** Versión compacta (portada): icono y título en una fila. */
  compact?: boolean;
  /** Elemento del título; en listas compactas no es un encabezado. */
  as?: 'h3' | 'p';
  /** Si se pasa, toda la tarjeta es un enlace. */
  href?: string;
  /** Foto opcional (nombre de archivo en src/assets/fotos/). */
  photo?: { name: string; alt: string };
  /** Tarjeta destacada: en escritorio, foto a la izquierda y texto a la derecha. */
  featured?: boolean;
}

const {
  icon,
  title,
  text,
  compact = false,
  as: Title = compact ? 'p' : 'h3',
  href,
  photo,
  featured = false,
} = Astro.props;
const Wrapper = href ? 'a' : 'article';
---

<Wrapper
  class:list={[
    'symptom',
    compact && 'symptom--compact',
    href && 'symptom--link',
    photo && 'symptom--photo',
    featured && 'symptom--featured',
  ]}
  href={href}
>
  {
    photo && (
      <Photo
        name={photo.name}
        alt={photo.alt}
        decorative={Boolean(href)}
        aiCredit={false}
        sizes={featured ? '(min-width: 640px) 50vw, 88px' : '(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 88px'}
        class="symptom__photo"
      />
    )
  }
  <span class="symptom__icon"><Icon name={icon} /></span>
  <div class="symptom__body">
    <Title class="symptom__title">{title}</Title>
    {text && <p class="symptom__text">{text}</p>}
  </div>
</Wrapper>

<style>
  .symptom {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    align-items: start;
    align-content: start;
    height: 100%;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
  }

  .symptom--link:hover {
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  .symptom--link:hover .symptom__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .symptom__icon {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .symptom__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  .symptom__text {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  /* Compacta (portada) */
  .symptom--compact {
    align-items: center;
    align-content: center;
    gap: var(--space-2);
    padding: var(--space-2);
  }

  .symptom--compact .symptom__icon {
    width: 40px;
    height: 40px;
  }

  .symptom--compact .symptom__title {
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  /* Con foto. Móvil: miniatura cuadrada a la izquierda, sin icono. */
  .symptom--photo {
    grid-template-columns: 88px 1fr;
    padding: var(--space-2);
  }

  .symptom--photo :global(.symptom__photo) {
    aspect-ratio: 1;
    border-radius: 8px;
  }

  .symptom--photo .symptom__icon {
    display: none;
  }

  /* ≥ 640 px: foto arriba a sangre, icono y texto debajo. */
  @media (min-width: 640px) {
    .symptom--photo {
      grid-template-columns: auto 1fr;
      padding: 0 var(--space-3) var(--space-3);
    }

    .symptom--photo :global(.symptom__photo) {
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--space-3));
      margin-bottom: var(--space-1);
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }

    .symptom--photo .symptom__icon {
      display: grid;
    }
  }

  /* ≥ 1100 px: icono sobre el título. */
  @media (min-width: 1100px) {
    .symptom--photo:not(.symptom--featured) {
      grid-template-columns: 1fr;
    }
  }

  /* Destacada (≥ 640 px): foto a la izquierda, texto a la derecha. */
  @media (min-width: 640px) {
    .symptom--featured {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      column-gap: var(--space-5);
      padding: 0;
    }

    .symptom--featured :global(.symptom__photo) {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin: 0;
      width: 100%;
      height: 100%;
      min-height: 15rem;
      aspect-ratio: auto;
    }

    .symptom--featured .symptom__icon {
      grid-column: 2;
      margin-top: var(--space-5);
    }

    .symptom--featured .symptom__body {
      grid-column: 2;
      padding-right: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .symptom--featured .symptom__title {
      font-size: var(--fs-h2);
    }

    .symptom--featured .symptom__text {
      font-size: 1.25rem;
    }
  }
</style>
