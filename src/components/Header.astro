---
import site from '../content/site.json';
import BrandMark from './BrandMark.astro';
import EmergencyButton from './EmergencyButton.astro';
import Icon from './Icon.astro';

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href;
---

<header class="site-header">
  <div class="container site-header__inner">
    {/* Primer elemento enfocable tras «Saltar al contenido». En móvil se fija abajo. */}
    <EmergencyButton variant="dock" class="site-header__emergency" />

    <a class="brand" href="/" aria-label={`${site.siteName}. ${site.ui.homeLabel}`}>
      <BrandMark />
      <span class="brand__text">
        <span class="brand__name">{site.siteName}</span>
        <span class="brand__tagline">{site.tagline}</span>
      </span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-open-label={site.ui.menuOpen}
      data-close-label={site.ui.menuClose}
    >
      <span class="menu-toggle__icon menu-toggle__icon--open"><Icon name="menu" /></span>
      <span class="menu-toggle__icon menu-toggle__icon--close"><Icon name="x" /></span>
      <span class="menu-toggle__label">{site.ui.menuOpen}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={site.ui.navLabel}>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector('.menu-toggle__label');

  function setOpen(open: boolean) {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    if (label) label.textContent = open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!;
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Un clic fuera de la cabecera cierra el menú.
  document.addEventListener('click', (event) => {
    const header = toggle?.closest('.site-header');
    if (header && !header.contains(event.target as Node)) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand toggle'
      'nav nav';
    align-items: center;
    column-gap: var(--space-2);
    min-height: 4.5rem;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding-block: var(--space-1);
    color: var(--color-primary);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-primary-strong);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .brand__tagline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 419px) {
    .brand__tagline {
      display: none;
    }
  }

  .menu-toggle {
    grid-area: toggle;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 var(--space-2);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--color-primary);
  }

  .menu-toggle__icon {
    display: inline-flex;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open,
  .menu-toggle[aria-expanded='false'] .menu-toggle__icon--close {
    display: none;
  }

  .site-nav {
    grid-area: nav;
    display: none;
    padding-bottom: var(--space-2);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .site-nav li {
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding-inline: var(--space-1);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    box-shadow: inset 4px 0 0 var(--color-primary);
    padding-left: var(--space-2);
  }

  /* Escritorio: cabecera fija con el botón 061 a la derecha */
  @media (min-width: 960px) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .site-header__inner {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: 'brand . toggle emergency';
      min-height: var(--header-h);
    }

    .site-header :global(.site-header__emergency) {
      grid-area: emergency;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: var(--gutter);
      width: 20rem;
      padding: var(--space-1);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      box-shadow: 0 16px 40px rgb(0 0 0 / 0.1);
    }

    .site-nav ul {
      border-top: 0;
    }

    .site-nav li:last-child {
      border-bottom: 0;
    }
  }

  /* Escritorio ancho: menú en línea (el lema se oculta para dejar sitio) */
  @media (min-width: 1280px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav emergency';
      column-gap: var(--space-4);
    }

    .menu-toggle,
    .brand__tagline {
      display: none;
    }

    .site-nav,
    .site-nav.is-open {
      position: static;
      display: block;
      width: auto;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      justify-self: end;
    }

    .site-nav ul {
      display: flex;
      gap: var(--space-1);
    }

    .site-nav li {
      border: 0;
    }

    .site-nav a {
      min-height: var(--tap);
      padding-inline: var(--space-1);
      border-radius: 8px;
      font-size: 1.0625rem;
    }

    .site-nav a:hover {
      background: none;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.35em;
    }

    .site-nav a[aria-current='page'] {
      padding-left: var(--space-1);
      box-shadow: inset 0 -3px 0 var(--color-primary);
      border-radius: 0;
    }
  }
</style>
