---
/**
 * Icono Lucide en línea, por su nombre en kebab-case (p. ej. "battery-low").
 * Se resuelve al compilar: en el HTML solo acaba el SVG de cada icono usado.
 */
import * as lucide from 'lucide-static';

interface Props {
  name: string;
  class?: string;
  /** Si se pasa, el icono deja de ser decorativo y se anuncia con este texto. */
  label?: string;
}

const { name, class: className = 'icon', label } = Astro.props;

const key = name.replace(/(^|-)([a-z0-9])/g, (_, __, c: string) => c.toUpperCase());
const source = (lucide as Record<string, unknown>)[key];
if (typeof source !== 'string') throw new Error(`Icono Lucide desconocido: "${name}"`);

const svg = source
  .replace(/<!--.*?-->/s, '')
  .replace(/\s(width|height)="24"/g, '')
  .replace(/class="[^"]*"/, `class="${className}"`)
  .replace(
    '<svg',
    label ? `<svg role="img" aria-label="${label}" focusable="false"` : '<svg aria-hidden="true" focusable="false"',
  );
---

<Fragment set:html={svg} />
