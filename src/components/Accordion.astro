---
/**
 * Acordeón basado en <details>/<summary>: accesible y funciona sin JavaScript.
 * Uso: <Accordion><AccordionItem title="…">…</AccordionItem></Accordion>
 * Si la URL lleva #id de un elemento, ese elemento se abre al llegar.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['accordion', className]} data-accordion>
  <slot />
</div>

<script>
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement && target.closest('[data-accordion]')) {
      target.open = true;
      target.querySelector('summary')?.focus({ preventScroll: true });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  .accordion {
    border-top: 1px solid var(--color-border);
  }
</style>
