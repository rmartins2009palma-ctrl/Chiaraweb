---
import Base from '../layouts/Base.astro';
import Accordion from '../components/Accordion.astro';
import AccordionItem from '../components/AccordionItem.astro';
import Draft from '../components/Draft.astro';
import PageHead from '../components/PageHead.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import pages from '../content/pages.json';
import data from '../content/testimonios.json';
import { hasAnyPhoto } from '../lib/photos';

const page = pages.testimonios;
const f = data.form;
const labels = {
  symptoms: data.symptomsLabel,
  readMore: data.readMore,
  readLess: data.readLess,
  example: data.exampleNote,
  years: data.yearsLabel,
};
const showAiNote = hasAnyPhoto(data.items.map((t) => t.photo));
---

<Base title={page.title} description={page.lede}>
  <PageHead title={page.title} lede={page.lede}>
    <p class="intro">{data.intro}</p>
  </PageHead>

  <section class="container" aria-labelledby="list-title">
    <h2 id="list-title" class="visually-hidden">{data.listTitle}</h2>
    <ul class="list" role="list">
      {
        data.items.map((t) => (
          <li>
            <TestimonialCard {...t} labels={labels} />
          </li>
        ))
      }
    </ul>
    {showAiNote && <p class="ai-note">{data.photosNote}</p>}
  </section>

  <div class="container community">
    <section class="share" aria-labelledby="form-title">
      <h2 id="form-title">{f.title}</h2>
      <p class="share__intro">{f.intro}</p>
      <p class="share__note"><Draft note={f.prototypeNote} /></p>

      <form class="form" data-share-form novalidate>
        <p class="form__summary" data-summary tabindex="-1" hidden>{f.errors.summary}</p>

        <div class="form__field">
          <label for="share-name">{f.fields.name}</label>
          <p class="form__help" id="share-name-help">{f.fields.nameHelp}</p>
          <input id="share-name" name="name" type="text" autocomplete="nickname" aria-describedby="share-name-help" />
        </div>

        <div class="form__field form__field--short">
          <label for="share-age">{f.fields.age}</label>
          <p class="form__help" id="share-age-help">{f.fields.ageHelp}</p>
          <input
            id="share-age"
            name="age"
            type="number"
            inputmode="numeric"
            min="18"
            max="110"
            aria-describedby="share-age-help"
          />
        </div>

        <div class="form__field">
          <label for="share-story">
            {f.fields.story} <span class="form__req">({f.required})</span>
          </label>
          <p class="form__help" id="share-story-help">{f.fields.storyHelp}</p>
          <p class="form__error" id="share-story-error" hidden>{f.errors.story}</p>
          <textarea
            id="share-story"
            name="story"
            rows="7"
            required
            aria-describedby="share-story-help share-story-error"></textarea>
        </div>

        <div class="form__field">
          <p class="form__error" id="share-consent-error" hidden>{f.errors.consent}</p>
          <label class="form__check">
            <input
              type="checkbox"
              name="consent"
              required
              aria-describedby="share-consent-error"
            />
            <span>{f.fields.consent} <span class="form__req">({f.required})</span></span>
          </label>
        </div>

        <button type="submit" class="btn">{f.submit}</button>
      </form>

      <div class="success" data-success role="status" hidden>
        <p>{f.success}</p>
      </div>
    </section>

    <section class="rules" aria-labelledby="rules-title">
      <h2 id="rules-title">{data.rules.title}</h2>
      <Accordion>
        {
          data.rules.items.map((r) => (
            <AccordionItem title={r.title}>
              <p>{r.text}</p>
            </AccordionItem>
          ))
        }
      </Accordion>
    </section>
  </div>
</Base>

<script>
  // «Leer más»: despliega el relato completo en la tarjeta.
  document.querySelectorAll<HTMLButtonElement>('[data-story-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = !open;
      btn.textContent = open ? btn.dataset.less! : btn.dataset.more!;
    });
  });

  // Formulario: valida en el navegador y muestra el agradecimiento. No envía nada.
  const form = document.querySelector<HTMLFormElement>('[data-share-form]')!;
  const success = document.querySelector<HTMLElement>('[data-success]')!;
  const summary = form.querySelector<HTMLElement>('[data-summary]')!;
  const story = form.querySelector<HTMLTextAreaElement>('#share-story')!;
  const consent = form.querySelector<HTMLInputElement>('[name="consent"]')!;

  function setError(input: HTMLInputElement | HTMLTextAreaElement, errorId: string, invalid: boolean) {
    input.setAttribute('aria-invalid', String(invalid));
    document.getElementById(errorId)!.hidden = !invalid;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const storyInvalid = story.value.trim() === '';
    const consentInvalid = !consent.checked;
    setError(story, 'share-story-error', storyInvalid);
    setError(consent, 'share-consent-error', consentInvalid);

    if (storyInvalid || consentInvalid) {
      summary.hidden = false;
      summary.focus();
      return;
    }

    summary.hidden = true;
    form.reset();
    form.hidden = true;
    success.hidden = false;
  });
</script>

<style>
  .intro {
    max-width: var(--measure);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-note {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .community {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-10);
  }

  @media (min-width: 960px) {
    .community {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-6);
      align-items: start;
    }
  }

  .share > * + * {
    margin-top: var(--space-2);
  }

  .share__intro {
    max-width: var(--measure);
  }

  .form {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  @media (min-width: 640px) {
    .form {
      padding: var(--space-4);
    }
  }

  .form__field label {
    font-weight: 700;
  }

  .form__help {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .form__req {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .form input[type='text'],
  .form input[type='number'],
  .form textarea {
    display: block;
    width: 100%;
    min-height: 3.5rem;
    margin-top: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border: 2px solid var(--color-text-muted);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .form__field--short input {
    max-width: 8rem;
  }

  .form textarea {
    resize: vertical;
  }

  .form input:focus-visible,
  .form textarea:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  .form [aria-invalid='true'] {
    border-style: dashed;
    border-color: var(--color-text);
  }

  .form__check {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-weight: 400 !important;
    cursor: pointer;
  }

  .form__check input {
    flex: none;
    width: 24px;
    height: 24px;
    margin: 2px 0 0;
    accent-color: var(--color-primary);
  }

  .form__error,
  .form__summary {
    font-weight: 700;
  }

  .form__error::before,
  .form__summary::before {
    content: '⚠ ';
  }

  .form__summary {
    padding: var(--space-2);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-card);
  }

  .form .btn {
    justify-self: start;
  }

  .success {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-left: 6px solid var(--color-primary);
    border-radius: var(--radius-card);
    background: var(--color-primary-soft);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .rules > h2 {
    margin-bottom: var(--space-2);
  }
</style>
