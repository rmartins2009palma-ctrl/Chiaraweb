---
/**
 * «Qué hacer»: única página, junto al botón de emergencias, donde se usa el rojo
 * --color-emergency (números de los pasos y banda de alerta).
 */
import Base from '../layouts/Base.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Draft from '../components/Draft.astro';
import EmergencyButton from '../components/EmergencyButton.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import pages from '../content/pages.json';
import data from '../content/que-hacer.json';
import { hasAnyPhoto } from '../lib/photos';

const page = pages['que-hacer'];
const showAiNote = hasAnyPhoto(data.steps.map((s) => s.photo));
---

<Base title={page.title} description={page.lede}>
  <PageHead title={page.title} lede={page.lede}>
    <Draft />
  </PageHead>

  <section class="container" aria-labelledby="alert-title">
    <div class="alert">
      <h2 id="alert-title">{data.alert.title}</h2>
      <p>{data.alert.text}</p>
      <EmergencyButton showAlt />
    </div>
  </section>

  <section class="container steps-section" aria-labelledby="steps-title">
    <h2 id="steps-title">{data.stepsTitle}</h2>
    <ol class="steps" role="list">
      {
        data.steps.map((step, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">
              {i + 1}
            </span>
            <Photo
              name={step.photo}
              alt={step.photoAlt}
              ratio="1/1"
              sizes="(min-width: 960px) 200px, 96px"
              aiCredit={false}
              decorative
              class="step__photo"
            />
            <div class="step__body">
              <h3>
                <span class="visually-hidden">
                  {data.stepLabel} {i + 1}:{" "}
                </span>
                {step.title}
              </h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {showAiNote && <p class="ai-note">{data.photosNote}</p>}

    <div class="company">
      <div>
        <h3>{data.company.title}</h3>
        <p>{data.company.text}</p>
      </div>
    </div>
  </section>

  <section class="container closing">
    <EmergencyButton showAlt />
    <Disclaimer />
  </section>
</Base>

<style>
  .alert {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    background: var(--color-surface);
    border: 2px solid var(--color-emergency);
    border-left-width: 10px;
    border-radius: var(--radius-card);
  }

  .alert h2 {
    font-size: var(--fs-h1);
  }

  .alert p {
    max-width: var(--measure);
    font-size: 1.25rem;
  }

  .alert :global(.emergency) {
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .alert {
      padding: var(--space-5);
    }
  }

  .steps-section {
    margin-top: var(--space-10);
  }

  .steps {
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step {
    display: grid;
    grid-template-columns: auto 96px 1fr;
    gap: var(--space-2);
    align-items: start;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .step:first-child {
    border-top: 1px solid var(--color-border);
  }

  .step__num {
    font-family: var(--font-display);
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-emergency);
    color: var(--color-on-emergency);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .step__body h3 {
    font-size: var(--fs-h2);
  }

  .step__body p {
    margin-top: var(--space-1);
    max-width: var(--measure);
    font-size: 1.1875rem;
  }

  /* Móvil: número y foto en fila, texto debajo a lo ancho. */
  @media (max-width: 559px) {
    .step {
      grid-template-columns: auto 96px;
    }

    .step__body {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .step {
      grid-template-columns: 80px 200px 1fr;
      gap: var(--space-4);
      align-items: center;
    }

    .step__num {
      width: 80px;
      height: 80px;
      font-size: 2.5rem;
    }
  }

  .ai-note {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .company {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    margin-top: var(--space-5);
    padding: var(--space-3);
    background: var(--color-primary-soft);
    border-radius: var(--radius-card);
  }

  .company p {
    margin-top: var(--space-1);
  }

  .closing {
    margin-top: var(--space-8);
  }

  .closing > * + * {
    margin-top: var(--space-4);
  }
</style>
