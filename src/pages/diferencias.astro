---
import Base from '../layouts/Base.astro';
import BodyCompare from '../components/BodyCompare.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Draft from '../components/Draft.astro';
import PageHead from '../components/PageHead.astro';
import Tabs from '../components/Tabs.astro';
import data from '../content/diferencias.json';
import pages from '../content/pages.json';

const page = pages.diferencias;
const t = data.table;
const keys = ['mujer', 'hombre'] as const;
const tabs = keys.map((id, i) => ({ id, label: t.columns[i] }));
---

<Base title={page.title} description={page.lede}>
  <PageHead title={page.title} lede={page.lede}>
    <Draft />
  </PageHead>

  <section class="container" aria-labelledby="compare-title">
    <h2 id="compare-title">{data.compare.title}</h2>
    <p class="intro">{data.compare.intro}</p>
    <BodyCompare
      figures={data.compare.figures}
      backNote={data.compare.backNote}
      zoneLabel={data.compare.zoneLabel}
    />
  </section>

  <section class="container table-section" aria-labelledby="table-title">
    <h2 id="table-title">{t.title}</h2>

    {/* ≥ 640 px: tabla de dos columnas */}
    <div class="table-wrap">
      <table class="compare-table">
        <caption class="visually-hidden">{t.caption}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{t.aspectLabel}</span></th>
            {t.columns.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            t.rows.map((row) => (
              <tr>
                <th scope="row">{row.aspect}</th>
                <td>{row.mujer}</td>
                <td>{row.hombre}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {/* < 640 px: pestañas Mujer / Hombre */}
    <Tabs id="diferencias" tabs={tabs} label={t.caption} class="table-tabs">
      {
        keys.map((key) => (
          <dl slot={key} class="tab-list">
            {t.rows.map((row) => (
              <div>
                <dt>{row.aspect}</dt>
                <dd>{row[key]}</dd>
              </div>
            ))}
          </dl>
        ))
      }
    </Tabs>

    <p class="note">{t.note} <span class="ref">{t.ref}</span></p>
  </section>

  <section class="container closing">
    <Disclaimer />
  </section>
</Base>

<style>
  .intro {
    margin: var(--space-1) 0 var(--space-3);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .table-section {
    margin-top: var(--space-10);
  }

  .table-section > h2 {
    margin-bottom: var(--space-3);
  }

  .table-wrap {
    display: none;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .compare-table th,
  .compare-table td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }

  .compare-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .compare-table thead th {
    background: var(--color-primary-soft);
    font-size: var(--fs-h3);
  }

  .compare-table tbody th {
    width: 24%;
    font-weight: 700;
  }

  .compare-table td {
    width: 38%;
  }

  .compare-table td + td {
    border-left: 1px solid var(--color-border);
  }

  .tab-list {
    margin: 0;
  }

  .tab-list > div {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .tab-list dt {
    font-weight: 700;
  }

  .tab-list dd {
    margin: var(--space-1) 0 0;
  }

  @media (min-width: 640px) {
    .table-wrap {
      display: block;
    }

    .table-section :global(.table-tabs) {
      display: none;
    }
  }

  .note {
    margin-top: var(--space-3);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .ref {
    font-size: var(--fs-small);
  }

  .closing {
    margin-top: var(--space-8);
  }
</style>
